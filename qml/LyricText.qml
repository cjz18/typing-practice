import QtQuick

Text {
    font.family: "Microsoft YaHei UI"
    font.pixelSize: 34
    width: parent.width * 0.86
    wrapMode: Text.Wrap
    horizontalAlignment: Text.AlignHCenter
    anchors.horizontalCenter: parent.horizontalCenter
    transformOrigin: Item.Center
    renderType: Text.QtRendering
}
